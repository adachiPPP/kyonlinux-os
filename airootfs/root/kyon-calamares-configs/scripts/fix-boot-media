#!/usr/bin/env bash

# fix-boot-media - locate the boot media files for Ventoy / Rufus ISO mode
#
# Standard archiso mounts the boot media at /run/archiso/bootmnt/ and places
# the squashfs at /run/archiso/bootmnt/<archisobasedir>/x86_64/airootfs.sfs.
# Ventoy and Rufus ISO mode may loop-mount or extract the ISO differently,
# so the standard path may not exist even though the live system booted.
#
# This script finds airootfs.sfs (and vmlinuz-linux) wherever they are on
# the running system and creates symlinks at the expected paths so that
# Calamares' unpackfs module can find them.

set -euo pipefail

EXPECTED_SFS="/run/archiso/bootmnt/arch/x86_64/airootfs.sfs"
EXPECTED_VMLINUZ="/run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux"

log() { printf 'fix-boot-media: %s\n' "$*" >&2; }

# ── 1. Find airootfs.sfs ──────────────────────────────────────────────────

find_sfs() {
    # Already at the expected path?
    [ -f "$EXPECTED_SFS" ] && { echo "$EXPECTED_SFS"; return 0; }

    local found=""

    # Search well-known mount points first (fast).
    for dir in /run/archiso/bootmnt /run/miso /run/media /mnt /media; do
        [ -d "$dir" ] || continue
        found=$(find "$dir" -maxdepth 5 -name "airootfs.sfs" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done

    # Check every mounted filesystem from /proc/mounts (handles Ventoy's
    # custom mount points andloop devices).
    while read -r _ mountpoint _ _ _ _; do
        case "$mountpoint" in
            /proc|/sys|/dev|/run/udev|/run/lock|/tmp) continue ;;
        esac
        [ -d "$mountpoint" ] || continue
        found=$(find "$mountpoint" -maxdepth 5 -name "airootfs.sfs" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done < /proc/mounts

    # Last resort: broad search from / (skipping /proc /sys /dev).
    found=$(find / -path /proc -prune -o -path /sys -prune -o -path /dev -prune \
        -o -name "airootfs.sfs" -type f -print 2>/dev/null | head -1)
    [ -n "$found" ] && { echo "$found"; return 0; }

    return 1
}

# ── 2. Find vmlinuz-linux ─────────────────────────────────────────────────

find_vmlinuz() {
    # Already at the expected path?
    [ -f "$EXPECTED_VMLINUZ" ] && { echo "$EXPECTED_VMLINUZ"; return 0; }

    local found="" search_root

    # If we found the squashfs, look for vmlinuz nearby first.
    if [ -n "${SFS_FOUND:-}" ]; then
        search_root=$(dirname "$SFS_FOUND")
        found=$(find "$search_root" -maxdepth 4 -name "vmlinuz-linux" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    fi

    # Fall back to the same broad search.
    for dir in /run/archiso/bootmnt /run/miso /run/media /mnt /media; do
        [ -d "$dir" ] || continue
        found=$(find "$dir" -maxdepth 5 -name "vmlinuz-linux" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done

    while read -r _ mountpoint _ _ _ _; do
        case "$mountpoint" in
            /proc|/sys|/dev|/run/udev|/run/lock|/tmp) continue ;;
        esac
        [ -d "$mountpoint" ] || continue
        found=$(find "$mountpoint" -maxdepth 5 -name "vmlinuz-linux" -type f 2>/dev/null | head -1)
        [ -n "$found" ] && { echo "$found"; return 0; }
    done < /proc/mounts

    return 1
}

# ── 3. Create symlinks ────────────────────────────────────────────────────

link_if_needed() {
    local target="$1" link_path="$2"
    [ -f "$link_path" ] && return 0          # already exists
    [ -f "$target" ]   || return 1            # source missing
    mkdir -p "$(dirname "$link_path")"
    ln -sf "$target" "$link_path"
    log "symlinked $link_path -> $target"
}

SFS_FOUND=""
SFS_FOUND=$(find_sfs) || true
if [ -z "$SFS_FOUND" ]; then
    log "WARNING: airootfs.sfs not found anywhere - unpackfs will likely fail"
    log "         (Ventoy / Rufus ISO mode may not be compatible with this ISO)"
    exit 0   # non-fatal: let unpackfs produce its own error
fi

log "found airootfs.sfs at $SFS_FOUND"
link_if_needed "$SFS_FOUND" "$EXPECTED_SFS"

VMLINUXINUZ_FOUND=""
VMLINUXINUZ_FOUND=$(find_vmlinuz) || true
if [ -n "$VMLINUXINUZ_FOUND" ]; then
    log "found vmlinuz-linux at $VMLINUXINUZ_FOUND"
    link_if_needed "$VMLINUXINUZ_FOUND" "$EXPECTED_VMLINUZ"
else
    log "WARNING: vmlinuz-linux not found (packages step will install the kernel)"
fi

exit 0
