# Default Plasma wallpaper for new users (Kyon Linux).
#
# The Image path points at the system wallpaper package rather than
# ~/.config/kyon.png because the org.kde.image plugin does not reliably
# expand "~"; /usr/share/wallpapers ships with the live image and is
# unpacked onto every installed system, so the path stays valid even if the
# user's home is moved or reinstalled.
#
# Containments 1-3 cover the first three screens at first login; extra
# containments stay dormant when fewer screens are present, and Plasma
# clones this wallpaper onto screens connected later.
#
# If plasmashell regenerates this file on first run and the wallpaper does
# not show, the one-shot autostart kyon-wallpaper-set (see
# ~/.config/autostart/kyon-wallpaper.desktop, copied to every new user via
# /etc/skel) applies it and never touches the user's wallpaper afterwards.

[Containments][1]
plugin=org.kde.desktopcontainment

[Containments][1][Wallpaper][org.kde.image][General]
FillMode=2
Image=/usr/share/wallpapers/KyonDefault/contents/images/1920x1080.png

[Containments][2]
plugin=org.kde.desktopcontainment

[Containments][2][Wallpaper][org.kde.image][General]
FillMode=2
Image=/usr/share/wallpapers/KyonDefault/contents/images/1920x1080.png

[Containments][3]
plugin=org.kde.desktopcontainment

[Containments][3][Wallpaper][org.kde.image][General]
FillMode=2
Image=/usr/share/wallpapers/KyonDefault/contents/images/1920x1080.png
